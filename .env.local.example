# Lyricshop environment variables.
# Copy this file to .env.local and fill in what you need. Every key is optional:
# without them the shop runs in demo mode.

# Stripe secret key (sk_test_... or sk_live_...). When set, checkout redirects to
# Stripe Checkout. When unset, checkout runs in demo mode and no payment is taken.
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# Public URL of the site, without a trailing slash. Used for absolute URLs in
# metadata and for Stripe's success/cancel redirects. Defaults to the request origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gemini API key for Nano Banana Pro (Gemini 3 Pro Image). Powers the Studio's AI
# graphics and "see it worn" photoshoots. Without it the AI panel shows setup help.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the image model id (defaults to gemini-3-pro-image, with
# gemini-3-pro-image-preview as a fallback).
# GEMINI_IMAGE_MODEL=gemini-3-pro-image
